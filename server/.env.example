# ===========================================
# MariaDB configuration
# ===========================================

# Database name
DB_NAME=pbcred

# Database user. DB_NAME, DB_USER, and DB_PASSWORD are required. The code has no root fallback.
# An empty DB_PASSWORD is allowed only when the variable is present (socket authentication).
DB_USER=root

# Database password
DB_PASSWORD=

# Unix socket connection (default)
# Uncomment to use the socket:
DB_SOCKET_PATH=/run/mysqld/mysqld.sock

# TCP connection (alternative to the socket)
# Used when DB_SOCKET_PATH is commented out:
# DB_HOST=localhost
# DB_PORT=3306

# ===========================================
# JWT configuration
# ===========================================

# Secret used to sign JWT tokens.
# The server does not start if this is shorter than 32 characters or matches a placeholder from the repository.
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Default token lifetime (without "remember me")
JWT_EXPIRES_IN=1d

# Token lifetime when "remember me" is set
JWT_REMEMBER_EXPIRES_IN=30d

# ===========================================
# Server
# ===========================================

# API server port
PORT=3001

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173
